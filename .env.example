# --- Autentikasi endpoint scoring ---
# Dicek terhadap header request POST /score, dipanggil sistem otorisasi pembayaran.
# Isi string acak, misal hasil: python3 -c "import secrets; print(secrets.token_hex(16))"
SCORING_API_KEY=<isi-string-acak>

# --- Autentikasi dashboard (JWT) ---
# Isi string acak, misal hasil: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=<isi-string-acak>
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# --- Kredensial Postgres ---
# Dipakai bersama oleh service Postgres di docker-compose.yml dan koneksi aplikasi.
# Bebas apa saja, ini kredensial database lokal yang kamu buat sendiri.
POSTGRES_USER=<isi-bebas>
POSTGRES_PASSWORD=<isi-bebas>
POSTGRES_DB=fraud_detection
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Koneksi Redis ---
# localhost saat dijalankan dari host (skrip batch, dev lokal); "redis"
# (hostname service Docker Compose) saat dijalankan dari dalam container.
REDIS_HOST=localhost
REDIS_PORT=6379
