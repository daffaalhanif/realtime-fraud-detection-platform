# --- Autentikasi endpoint scoring ---
# Dicek terhadap header request POST /score, dipanggil sistem otorisasi pembayaran.
# Isi string acak, misal hasil: python3 -c "import secrets; print(secrets.token_hex(16))"
SCORING_API_KEY=<isi-string-acak>

# --- Autentikasi dashboard (JWT) ---
# Isi string acak, misal hasil: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=<isi-string-acak>
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# --- Kredensial Postgres ---
# Dipakai bersama oleh service Postgres di docker-compose.yml dan koneksi aplikasi.
# Bebas apa saja, ini kredensial database lokal yang kamu buat sendiri.
# Hindari karakter @ : / ? # % di password, karena dipakai di URL koneksi MLflow.
POSTGRES_USER=<isi-bebas>
POSTGRES_PASSWORD=<isi-bebas>
POSTGRES_DB=fraud_detection
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Koneksi Redis ---
# localhost saat dijalankan dari host (skrip batch, dev lokal); "redis"
# (hostname service Docker Compose) saat dijalankan dari dalam container.
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Koneksi Kafka ---
# 127.0.0.1:9092 saat dijalankan dari host; kafka:29092 (listener internal
# Docker Compose) saat dijalankan dari dalam container.
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092

# --- Antrean cadangan Kafka ---
# Berkas SQLite penampung pesan yang gagal dititip ke Kafka. Di container, arahkan ke
# folder yang di-mount sebagai volume supaya isinya selamat saat container dibuat ulang.
RETRY_BUFFER_PATH=var/retry_buffer.sqlite3

# --- MLflow tracking server ---
# Dipakai skrip training dari host. Port 5001 karena 5000 dipakai AirPlay Receiver di macOS.
MLFLOW_TRACKING_URI=http://localhost:5001
